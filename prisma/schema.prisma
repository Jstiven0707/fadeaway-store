generator client {
  provider = "prisma-client-js"
}

// En Prisma 7 la URL de conexión ya no va aquí: se define en prisma7.config.ts
datasource db {
  provider = "mysql"
}

model Categoria {
  id                    Int             @id @default(autoincrement())
  nombreCat             String          @map("nombre_cat") @db.VarChar(100)
  /// Identificador en la URL: perfumeria, maquillaje, cabello...
  slug                  String          @unique @db.VarChar(60)
  estadoRegis           EstadoRegis     @default(ACTIVO) @map("estado_regis")
  fechaCrecion          DateTime        @db.Date @map("fecha_crecion")
  horaDeCrecion         DateTime        @db.Time @map("hora_de_crecion")
  fechahoraModificacion DateTime        @default(now()) @updatedAt @map("Fechahora_modificacion")
  subcategorias         Subcategoria[]

  @@map("categorias")
}

model Subcategoria {
  id                    Int             @id @default(autoincrement())
  idCategoria           Int             @map("id_categoria")
  nombreSubcat          String          @map("nombre_subcat") @db.VarChar(100)
  /// Segunda parte de la URL: mujer, bases, mascarillas...
  slug                  String          @db.VarChar(60)
  imageUrl              String?         @map("image_url") @db.VarChar(255)
  estadoRegis           EstadoRegis     @default(ACTIVO) @map("estado_regis")
  fechaCrecion          DateTime        @db.Date @map("fecha_crecion")
  horaDeCrecion         DateTime        @db.Time @map("hora_de_crecion")
  fechahoraModificacion DateTime        @default(now()) @updatedAt @map("Fechahora_modificacion")
  
  categoria             Categoria       @relation(fields: [idCategoria], references: [id], onDelete: Cascade)
  productos             Producto[]

  @@unique([idCategoria, slug])
  @@map("subcategorias")
}

model Producto {
  id                    Int             @id @default(autoincrement())
  idSubcategoria        Int             @map("id_subcategoria")
  nombre                String          @db.VarChar(150)
  descripcion           String?         @db.Text
  precio                Decimal         @db.Decimal(10, 2)
  imageUrl              String?         @map("image_url") @db.VarChar(255)
  /// Se muestra ademas en la seccion Nuevos Lanzamientos
  esLanzamiento         Boolean         @default(false) @map("es_lanzamiento")
  estadoRegis           EstadoRegis     @default(ACTIVO) @map("estado_regis")
  fechaCrecion          DateTime        @db.Date @map("fecha_crecion")
  horaDeCrecion         DateTime        @db.Time @map("hora_de_crecion")
  fechahoraModificacion DateTime        @default(now()) @updatedAt @map("Fechahora_modificacion")

  subcategoria          Subcategoria    @relation(fields: [idSubcategoria], references: [id], onDelete: Cascade)
  variants              ProductVariant[]
  detalleOrdenes        DetalleOrden[]
  resenas               Resena[]

  @@map("productos")
}

model ProductVariant {
  id           Int          @id @default(autoincrement())
  idProducto   Int          @map("id_producto")
  /// Presentación de venta: 30ml, 50ml, 100ml, 200g, Único...
  presentacion String       @db.VarChar(40)
  stock        Int          @default(0)
  estadoRegis  EstadoRegis  @default(ACTIVO) @map("estado_regis")

  producto     Producto     @relation(fields: [idProducto], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Usuario {
  id                    Int             @id @default(autoincrement())
  nombre                String          @db.VarChar(100)
  email                 String          @unique @db.VarChar(150)
  password              String          @db.VarChar(255)
  rol                   RolUsuario?     @default(cliente)
  estadoRegis           EstadoRegis     @default(ACTIVO) @map("estado_regis")
  fechaCrecion          DateTime        @db.Date @map("fecha_crecion")
  horaDeCrecion         DateTime        @db.Time @map("hora_de_crecion")
  fechahoraModificacion DateTime        @default(now()) @updatedAt @map("Fechahora_modificacion")
  ordenes               Orden[]

  @@map("usuarios")
}

model Orden {
  id             Int             @id @default(autoincrement())
  /// Codigo visible para el cliente: OP-123456
  numero         String          @unique @db.VarChar(20)
  idUsuario      Int?            @map("id_usuario")

  nombre         String          @db.VarChar(100)
  apellido       String          @db.VarChar(100)
  ciudad         String          @db.VarChar(100)
  direccionEnvio String          @map("direccion_envio") @db.Text
  telefono       String          @db.VarChar(30)
  notas          String?         @db.Text

  metodoPago     MetodoPago      @map("metodo_pago")
  canal          CanalVenta      @default(Web)
  estado         EstadoOrden     @default(PENDIENTE_PAGO)

  subtotal       Decimal         @db.Decimal(10, 2)
  costoEnvio     Decimal         @default(0) @map("costo_envio") @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)

  /// Token del enlace de reseña, se genera al marcar Entregado
  tokenResena    String?         @unique @map("token_resena") @db.VarChar(40)

  estadoRegis    EstadoRegis     @default(ACTIVO) @map("estado_regis")
  fechaCrecion   DateTime        @db.Date @map("fecha_crecion")
  horaDeCrecion  DateTime        @db.Time @map("hora_de_crecion")
  fechahoraModificacion DateTime @default(now()) @updatedAt @map("Fechahora_modificacion")

  usuario        Usuario?        @relation(fields: [idUsuario], references: [id], onDelete: SetNull)
  detalles       DetalleOrden[]
  resenas        Resena[]
  historial      HistorialEstado[]
  pagos          Pago[]

  @@index([estado])
  @@map("ordenes")
}

/// Cada cambio de estado queda registrado: sirve para saber quien movio que y cuando.
model HistorialEstado {
  id          Int         @id @default(autoincrement())
  idOrden     Int         @map("id_orden")
  estado      EstadoOrden
  nota        String?     @db.VarChar(255)
  fechaHora   DateTime    @default(now()) @map("fecha_hora")

  orden       Orden       @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  @@index([idOrden])
  @@map("historial_estados")
}

/// Pago recibido de un pedido. Se registra cuando el dinero entra:
/// al confirmar una transferencia, o al entregar si es contraentrega.
model Pago {
  id          Int         @id @default(autoincrement())
  idOrden     Int         @map("id_orden")
  metodo      MetodoPago
  monto       Decimal     @db.Decimal(10, 2)
  /// Numero de transaccion o comprobante que reporta el cliente
  referencia  String?     @db.VarChar(80)
  nota        String?     @db.VarChar(255)
  fechaHora   DateTime    @default(now()) @map("fecha_hora")
  estadoRegis EstadoRegis @default(ACTIVO) @map("estado_regis")

  orden       Orden       @relation(fields: [idOrden], references: [id], onDelete: Cascade)

  @@index([fechaHora])
  @@index([idOrden])
  @@map("pagos")
}

/// Reseña que deja el cliente despues de recibir el pedido.
model Resena {
  id            Int         @id @default(autoincrement())
  idOrden       Int         @map("id_orden")
  idProducto    Int?        @map("id_producto")
  /// 1 a 5 estrellas
  calificacion  Int
  comentario    String?     @db.Text
  nombreCliente String      @map("nombre_cliente") @db.VarChar(100)
  /// Solo las publicadas se muestran en la tienda
  publicada     Boolean     @default(true)
  estadoRegis   EstadoRegis @default(ACTIVO) @map("estado_regis")
  fechaCrecion  DateTime    @default(now()) @map("fecha_crecion")

  orden         Orden       @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  producto      Producto?   @relation(fields: [idProducto], references: [id], onDelete: SetNull)

  @@index([idProducto])
  @@map("resenas")
}

/// Configuracion editable desde el admin: numeros de Nequi/Daviplata, QR, WhatsApp.
model Ajuste {
  clave String @id @db.VarChar(60)
  valor String @db.Text

  @@map("ajustes")
}

model DetalleOrden {
  id             Int         @id @default(autoincrement())
  idOrden        Int         @map("id_orden")
  idProducto     Int?        @map("id_producto")
  /// Nombre al momento de la venta: el producto puede cambiar o retirarse despues
  nombreProducto String      @map("nombre_producto") @db.VarChar(150)
  /// Presentación vendida (antes era "talla")
  presentacion   String      @db.VarChar(40)
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(10, 2) @map("precio_unitario")
  estadoRegis    EstadoRegis @default(ACTIVO) @map("estado_regis")

  orden          Orden       @relation(fields: [idOrden], references: [id], onDelete: Cascade)
  producto       Producto?   @relation(fields: [idProducto], references: [id], onDelete: SetNull)

  @@map("detalle_ordenes")
}

enum EstadoRegis {
  ACTIVO
  INACTIVO
}

enum RolUsuario {
  admin
  cliente
}

/// Flujo del pedido en dos etapas.
/// Validacion: PENDIENTE_PAGO -> CONFIRMADO
/// Logistica:  PENDIENTE_ALISTAMIENTO -> EN_PREPARACION -> ALISTADO -> ENVIADO -> ENTREGADO
/// CANCELADO cubre tambien las devoluciones.
enum EstadoOrden {
  PENDIENTE_PAGO
  CONFIRMADO
  PENDIENTE_ALISTAMIENTO
  EN_PREPARACION
  ALISTADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  NEQUI
  DAVIPLATA
  CONTRAENTREGA
}

enum CanalVenta {
  Web
  WhatsApp
  Facebook
  Instagram
  Directo
}