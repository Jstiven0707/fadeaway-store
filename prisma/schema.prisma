datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id_categoria Int       @id @default(autoincrement())
  descripcion  String    @db.VarChar(50)
  slug         String    @unique @db.VarChar(50)
  products     Product[]

  @@map("categories")
}

model Product {
  id               String            @id @default(uuid()) @db.VarChar(36)
  title            String            @db.VarChar(255)
  slug             String            @unique @db.VarChar(255)
  description      String?           @db.Text
  price            Decimal           @db.Decimal(10, 2)
  category_id      Int?
  images           Json?             
  is_featured      Boolean           @default(false)
  created_at       DateTime          @default(now())
  
  category         Category?         @relation(fields: [category_id], references: [id_categoria], onDelete: SetNull)
  fragranceDetails FragranceDetail?
  variants         ProductVariant[]

  @@map("products")
}

model FragranceDetail {
  product_id          String   @id @db.VarChar(36)
  nombre_perfume      String   @db.VarChar(255)
  descripcion_perfume String?  @db.Text
  volume_ml           Int
  
  product             Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("fragrance_details")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.VarChar(36)
  product_id String?  @db.VarChar(36)
  size       String?  @db.VarChar(20)
  color      String?  @db.VarChar(50)
  stock      Int      @default(0)
  created_at DateTime @default(now())
  
  product    Product? @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_variants")
}